{
  "name": "anode",
  "version": "0.0.0",
  "private": true,
  "description": "AI inspection copilot for corrosion: ISO 4628-3 grading, severity, mechanisms and signed reports.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tokens": "node scripts/build-tokens.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "schemas": "vite-node scripts/export-schemas.ts"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
