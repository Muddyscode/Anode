{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "modelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "percentAreaRusted": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "outline": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "minItems": 4,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  }
                ]
              }
            }
          }
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "modelConfidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "modelName",
    "modelVersion",
    "percentAreaRusted",
    "outline",
    "modelConfidence"
  ],
  "additionalProperties": false
}
