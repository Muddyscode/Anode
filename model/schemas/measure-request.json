{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "imageUrl": {
      "type": "string",
      "format": "uri"
    },
    "widthPx": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "heightPx": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "mmPerPx": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "imageUrl",
    "widthPx",
    "heightPx",
    "mmPerPx"
  ],
  "additionalProperties": false
}
